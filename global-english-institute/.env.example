# --- Public build-time values (Vercel → Project → Settings → Environment Variables) ---
# These are compiled into the browser bundle by set-env.js, so only public values go here.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# --- Server-only secrets: NEVER put these in Vercel or src/environments ---
# Resend is only called from Supabase Edge Functions. Set it as an Edge Function secret:
#   supabase secrets set RESEND_API_KEY=re_your_resend_api_key
# RESEND_API_KEY=re_your_resend_api_key
